.DS_Store
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Built datasets (data/processed/<name>/) and local copies of a source (data/raw/). A recipe
# builds the same rows on any machine.
data/raw/
data/processed/*
!data/processed/.gitkeep
# Corpora for the coach narrator (models/coach-narrator/corpus/): third-party text and per-position
# tables too large to commit, rebuilt by their scripts.
data/corpus/

# What the harness writes beside a run's record: predictions, weights, logs, and every smoke run.
artifacts/
*.pt
*.pth

# The chess app checkout the bridge fetches, and data that must stay off GitHub.
.cache/
private/

# LaTeX's working files. A paper's paper.pdf and what its generator wrote are committed.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
